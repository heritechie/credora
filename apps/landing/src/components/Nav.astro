---
import { site, navLinks } from '../site';
---

<nav class="nav" aria-label="Primary">
	<div class="container nav-inner">
		<a href="#top" class="brand" aria-label="Credora home">
			<svg class="brand-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<rect x="2.5" y="2.5" width="19" height="19" rx="4" stroke="currentColor" stroke-width="2" />
				<path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
			<span class="brand-name">Credora</span>
		</a>

		<ul class="nav-links">
			{navLinks.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))}
			<li>
				<a href={site.github} class="nav-github">
					<svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
						<path
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
					<span>GitHub</span>
				</a>
			</li>
		</ul>

		<a href="#get-started" class="btn btn-primary nav-cta">Get Started</a>
	</div>
</nav>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(6, 10, 19, 0.82);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--c-line-dark);
		color: var(--c-ink-dark);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 4rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--c-ink-dark);
		text-decoration: none;
		font-weight: 650;
		font-size: 1.06rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.brand-mark {
		width: 1.45rem;
		height: 1.45rem;
		color: var(--c-accent);
	}

	.nav-links {
		display: flex;
		align-items: center;
		list-style: none;
		margin: 0;
		padding: 0;
		margin-left: auto;
	}

	.nav-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--c-muted-dark);
		text-decoration: none;
		font-size: 0.9375rem;
		padding: 0.45rem 0.75rem;
		transition: color 0.15s ease;
	}

	.nav-links a:hover {
		color: var(--c-ink-dark);
	}

	.nav-cta {
		margin-left: 0.75rem;
		padding: 0.55rem 1.1rem;
		font-size: 0.9rem;
	}

	@media (max-width: 780px) {
		.nav-links {
			display: none;
		}
	}
</style>