---
import { site } from '../site';

const chain = ['Your Provider', 'Your Credentials', 'Credora', 'Your Decision'];
---

<section class="section oss" id="open-source">
	<div class="container">
		<div class="oss-grid">
			<div class="oss-copy">
				<div class="section-head">
					<p class="eyebrow">Open Source</p>
					<h2>Open source by design.</h2>
				</div>
				<p class="oss-lede">
					Credora is open source. You can run the infrastructure yourself,
					read the source, and see exactly how each assessment executes.
				</p>
				<ul class="oss-list">
					<li>Inspect the engine and its policies</li>
					<li>Run a full assessment locally</li>
					<li>Extend with your own providers and rules</li>
				</ul>
				<p class="oss-lede oss-statement">
					{site.principle}
				</p>
				<p class="oss-lede">
					Nothing is hidden behind a hosted service. The decision process and
					its evidence are artifacts you can verify yourself.
				</p>
			</div>

			<div class="oss-chain" aria-label="Credora works with your providers">
				{chain.map((step, i) => (
					<>
						<div class="oss-step">
							<span aria-hidden="true" class="oss-index">
								{String(i + 1).padStart(2, '0')}
							</span>
							{step}
						</div>
						{i < chain.length - 1 && <span class="oss-arrow" aria-hidden="true">&darr;</span>}
					</>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.oss {
		background: var(--c-bg-light);
		border-top: 1px solid var(--c-line);
	}

	.oss-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 6vw, 4.5rem);
		align-items: center;
	}

	.oss-lede {
		margin-top: 1.1rem;
		color: var(--c-muted);
		max-width: 40rem;
	}

	.oss-statement {
		font-family: var(--font-mono);
		font-size: 1.05rem;
		font-weight: 650;
		color: var(--c-accent);
	}

	.oss-list {
		list-style: none;
		margin: 1.4rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.oss-list li {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		font-size: 0.95rem;
		color: var(--c-ink);
		font-weight: 500;
	}

	.oss-list li::before {
		content: '';
		flex: 0 0 auto;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--c-accent);
		transform: translateY(-2px);
	}

	.oss-chain {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		max-width: 22rem;
	}

	.oss-step {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.85rem 1rem;
		background: var(--c-bg-elev-light);
		border: 1px solid var(--c-line);
		border-radius: var(--radius);
		font-weight: 600;
		font-size: 0.95rem;
		font-family: var(--font-mono);
	}

	.oss-step:last-child {
		border-color: rgba(77, 141, 255, 0.45);
		background: var(--c-accent-soft);
	}

	.oss-index {
		font-weight: 400;
		font-size: 0.8rem;
		color: var(--c-accent);
	}

	.oss-arrow {
		text-align: center;
		color: var(--c-muted);
		padding-block: 0.15rem;
		line-height: 1;
	}

	@media (max-width: 820px) {
		.oss-grid {
			grid-template-columns: 1fr;
		}
	}
</style>