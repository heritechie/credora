---
export type IconName =
	| 'layers'
	| 'terminal'
	| 'code'
	| 'target'
	| 'eye'
	| 'archive'
	| 'clock'
	| 'key'
	| 'check'
	| 'check-circle';

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 22 } = Astro.props;

const icons: Record<IconName, string> = {
	layers: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3.5 13l8.5 4.7 8.5-4.7"/>',
	terminal:
		'<rect x="3" y="4.5" width="18" height="15" rx="2"/>' +
		'<path d="M7 9.5l3 2.5-3 2.5"/><path d="M13 14.5h4"/>',
	code: '<path d="M8.5 8l-4.5 4 4.5 4"/><path d="M15.5 8l4.5 4-4.5 4"/>',
	target:
		'<circle cx="12" cy="12" r="7.5"/><circle cx="12" cy="12" r="2.5"/>' +
		'<path d="M12 2.5v2.5M12 19v2.5M2.5 12h2.5M19 12h2.5"/>',
	eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
	archive:
		'<rect x="3" y="4" width="18" height="5" rx="1"/>' +
		'<path d="M5 9v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"/><path d="M10 13h4"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
	key: '<circle cx="7.5" cy="16.5" r="3.75"/><path d="M10.2 13.8L20.5 3.5"/><path d="M16.5 7.5l2.5 2.5"/>',
	check: '<path d="M5 12.5l4.5 4.5L19 7"/>',
	'check-circle':
		'<circle cx="12" cy="12" r="9"/>' +
		'<path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
};
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<Fragment set:html={icons[name]} />
</svg>