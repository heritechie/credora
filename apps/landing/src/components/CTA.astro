---
import { site } from '../site';
---

<section class="section cta" id="get-started">
	<div class="container cta-inner">
		<h2>Build your credit decisioning stack.</h2>
		<p>
			Start locally. Define an assessment. Connect your providers. Produce
			explainable decisions.
		</p>
		<div class="cta-actions">
			<a href={site.github} class="btn btn-primary">Get Started</a>
			<a href={site.github} class="btn btn-secondary">View GitHub</a>
		</div>
	</div>
</section>

<style>
	.cta {
		background: var(--c-bg);
		color: var(--c-ink-dark);
		position: relative;
		overflow: hidden;
		text-align: center;
	}

	.cta::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(
			55% 90% at 50% 100%,
			rgba(77, 141, 255, 0.16),
			transparent 70%
		);
		pointer-events: none;
	}

	.cta-inner {
		position: relative;
		max-width: 46rem;
	}

	.cta h2 {
		font-size: clamp(1.9rem, 4.4vw, 3rem);
		letter-spacing: -0.02em;
		line-height: 1.12;
	}

	.cta p {
		margin-top: 1.1rem;
		color: var(--c-muted-dark);
		font-size: 1.0625rem;
	}

	.cta-actions {
		display: flex;
		justify-content: center;
		gap: 0.85rem;
		margin-top: 2rem;
		flex-wrap: wrap;
	}
</style>