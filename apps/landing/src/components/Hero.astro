---
import { site } from '../site';
import heroPoster from '../assets/video/credora-hero.webp';
import heroVideoWebm from '../assets/video/credora-hero.webm';
import heroVideoMp4 from '../assets/video/credora-hero.mp4';
const posterSrc = heroPoster.src;
const videoWebmSrc = heroVideoWebm.src;
const videoMp4Src = heroVideoMp4.src;
---

<section class="hero" id="top">
	<div class="container hero-inner">
		<!-- Subtle left-side scrim: keeps the headline, paragraph, and CTA readable
		     on a clean dark area while the visual stays strong on the right. -->
		<div class="hero-scrim" aria-hidden="true"></div>

		<div class="hero-copy">
			<p class="hero-eyebrow">Open-source credit decisioning infrastructure</p>
			<h1>{site.headline}</h1>
			<p class="hero-lede">
				Open-source infrastructure for orchestrating credit data, scoring,
				policies, and decisions — using the providers you already have.
				Credora sits between your application and your providers. It does not
				replace them; it coordinates them.
			</p>
			<div class="hero-actions">
				<a href="#get-started" class="btn btn-primary">Get Started</a>
				<a href={site.github} class="btn btn-secondary">View on GitHub</a>
			</div>
			<p class="hero-principle">{site.principle}</p>
		</div>

		<!-- Decorative infrastructure visualization layer (blended into the right
		     column of the container, contained within the centered composition) -->
		<div class="hero-visual" aria-hidden="true">
			<!-- Poster still (shown on mobile and when reduced motion is preferred) -->
			<img class="hero-poster" src={posterSrc} alt="" width="960" height="540" />
			<!-- Animated scene (desktop, motion permitted) -->
			<video
				class="hero-video"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster={posterSrc}
			>
				<source src={heroVideoWebm} type="video/webm" />
				<source src={heroVideoMp4} type="video/mp4" />
			</video>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--c-bg);
		background-image:
			linear-gradient(rgba(148, 163, 184, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(148, 163, 184, 0.055) 1px, transparent 1px);
		background-size: 44px 44px;
		color: var(--c-ink-dark);
	}

	/* ---- Centered composition ----
	   The hero copy (left) and the infrastructure visual (right) share the same
	   centered container and split it ~45/55, so the scene belongs to one balanced
	   composition instead of escaping toward the viewport edge. A local, slightly
	   wider container (1280px) gives comfortable side margins on wide screens
	   without changing the global design-system container for other sections. */
	.hero-inner {
		--hero-max: 1280px;
		/* NOTE: keep this element free of opacity/transform/filter/z-index so it does
		   NOT become a stacking context — the visual blends (screen mode) into the
		   hero grid behind it. */
		position: relative;
		display: grid;
		grid-template-columns:
			minmax(0, 45fr)
			minmax(0, 55fr);
		gap: clamp(1.5rem, 3vw, 3rem);
		align-items: center;
		max-width: var(--hero-max);
		padding-block: clamp(4rem, 10vw, 8rem);
	}

	/* ---- Decorative visual layer (right column) ---- */
	.hero-visual {
		position: relative;
		z-index: 1;
		width: 100%;
		aspect-ratio: 16 / 10;
		pointer-events: none;
		/* no border, no radius, no shadow, no padding, no panel background */
		/* blend the near-black scene into the dark hero background */
		mix-blend-mode: screen;
		opacity: 0.96;
		/* Directional edge fading — no single large radial mask, so there is no
		   oval/ellipse shape. All edges fade subtly into the grid so no container
		   edge or mask shape is visible. Layers are combined by intersection
		   (source-in) for a soft, directional dissolve. */
		-webkit-mask-image:
			linear-gradient(to right, transparent 0%, black 14%),
			linear-gradient(to bottom, transparent 0%, black 10%),
			linear-gradient(to top, transparent 0%, black 10%),
			linear-gradient(to left, transparent 0%, black 12%);
		mask-image:
			linear-gradient(to right, transparent 0%, black 14%),
			linear-gradient(to bottom, transparent 0%, black 10%),
			linear-gradient(to top, transparent 0%, black 10%),
			linear-gradient(to left, transparent 0%, black 12%);
		-webkit-mask-composite: source-in;
		mask-composite: intersect;
	}

	/* Keep the copy above the visual and scrim. */
	.hero-copy {
		position: relative;
		z-index: 2;
		max-width: 34rem;
	}

	/* Subtle gradient behind the text so the left side stays dark/readable. The
	   visual sits in the right column, so the scrim stays light in that region. */
	.hero-scrim {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgba(6, 10, 19, 0.96) 0%,
			rgba(6, 10, 19, 0.78) 30%,
			rgba(6, 10, 19, 0.2) 52%,
			transparent 70%
		);
	}

	.hero-video,
	.hero-poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Video only on desktop/motion; poster is the mobile + reduced-motion fallback */
	.hero-poster {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-video {
			display: none;
		}

		.hero-poster {
			display: block;
		}
	}

	.hero-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--c-accent);
		margin-bottom: 1.1rem;
	}

	.hero h1 {
		font-size: clamp(2.25rem, 5.4vw, 3.75rem);
		line-height: 1.06;
		letter-spacing: -0.025em;
		max-width: 20ch;
	}

	.hero-lede {
		margin-top: 1.25rem;
		max-width: 40rem;
		font-size: clamp(1rem, 1.6vw, 1.125rem);
		color: var(--c-muted-dark);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.hero-principle {
		margin-top: 2.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--c-line-dark);
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: var(--c-ink-dark);
	}

	/* ---- Tablet ---- */
	@media (max-width: 900px) {
		.hero-inner {
			--hero-visual-h: 110%;
			display: block;
			max-width: none;
		}

		.hero-visual {
			position: absolute;
			top: auto;
			left: 50%;
			right: auto;
			bottom: 0;
			transform: translateX(-50%);
			aspect-ratio: auto;
			width: 100vw;
			height: var(--hero-visual-h);
			mix-blend-mode: normal;
			opacity: 0.6;
			-webkit-mask-image: none;
			mask-image: none;
		}

		.hero-visual::after {
			content: '';
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			height: 100%;
			background: linear-gradient(
				to bottom,
				transparent 0%,
				transparent 55%,
				var(--c-bg) 100%
			);
		}

		.hero-inner {
			padding-bottom: clamp(3rem, 8vw, 6rem);
		}
	}

	/* ---- Mobile ---- */
	/* A static poster backdrop reads better than a badly cropped 16:9 video
	   squeezed into a narrow column. Hide the video, show the poster. */
	@media (max-width: 600px) {
		.hero-inner {
			--hero-visual-h: 100%;
		}

		.hero-video {
			display: none;
		}

		.hero-poster {
			display: block;
		}

		.hero-visual {
			height: var(--hero-visual-h);
			opacity: 0.45;
		}

		.hero-copy {
			max-width: none;
		}

		.hero h1 {
			max-width: 11ch;
		}
	}
</style>
