# Credora environment configuration template.
# Copy to .env and adjust. Never commit real credentials.

# Database driver: sqlite (default) or postgres
DATABASE_DRIVER=sqlite

# SQLite: file path for the database (default: ./data/credora.db)
DATABASE_URL=./data/credora.db

# PostgreSQL: connection string (used when DATABASE_DRIVER=postgres)
# DATABASE_URL=postgres://credora:credora@localhost:5432/credora

# Engine HTTP server port
HTTP_PORT=8080

# Logging level: debug | info | warn | error
LOG_LEVEL=info
